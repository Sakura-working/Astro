{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"vcs": {
			"enabled": true,
			"clientKind": "git",
			"useIgnoreFile": true,
			"defaultBranch": "master"
	},
	"overrides": [
		{
			"includes": ["**/*.css", "**/*.scss", "**/*.astro"],
			"css": {
				"correctness": {
						"noUnknownPseudoClass": "off",
						"noUnknownAtRule": "off",
						"noUnknownTypeSelector": "off"
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"javascript": {
				"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
				},
				"suspicious": {
						"noExplicitAny": "off"
				}
			}
		}
	],
	"linter": {
			"enabled": true,
			"rules": {
					"recommended": true,
					"suspicious": {
						"noExplicitAny": "warn"
					},
					"style": {
						"useImportType": "warn"
					},
					"correctness": {
						"noUnusedVariables": "warn",
						"noUnusedImports": "warn"
					},
					"complexity": {
						"noForEach": "warn"
					},
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
			}
	},
	"css": {
			"correctness": {
						"noUnknownPseudoClass": "off",
						"noUnknownAtRule": "off",
						"noUnknownTypeSelector": "off"
				}
	},
	"formatter": {
			"enabled": true,
			"formatWithErrors": false,
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineWidth": 100,
			"lineEnding": "lf"
	},
	"javascript": {
			"formatter": {
					"quoteStyle": "single",
					"jsxQuoteStyle": "double",
					"trailingCommas": "all",
					"semicolons": "asNeeded",
					"arrowParentheses": "always",
					"bracketSameLine": false,
					"bracketSpacing": true,
					"quoteProperties": "asNeeded"
			}
	},
	"json": {
			"formatter": {
					"enabled": true
			}
	}
}
